        <item quantity="other">%1$d bits</item>
    </plurals>
    <string name="format_mismatch_limit_note">Default and Strict allow 6 bits; Relaxed allows 9 bits. Compares known bits in both copies. Excludes ? and manual bits determined by explicit ECC/mask selections alone. Zero requires exact agreement at compared positions.</string>
    <string name="data_ecc_mismatch_limit">Known data/ECC bit error limit</string>
    <string name="data_ecc_mismatch_limit_unlimited">Unlimited</string>
    <string name="data_ecc_mismatch_limit_exact">0 bits (exact match)</string>
    <plurals name="data_ecc_mismatch_limit_bits">
        <item quantity="one">%1$d bit</item>
        <item quantity="other">%1$d bits</item>
    </plurals>
    <string name="data_ecc_mismatch_limit_note" formatted="false">Strict uses 0.875% of total data/ECC bits; Relaxed uses 10%, both rounded up. Default uses Strict for Versions 1–4 and Relaxed for Version 5 onward. Limits differences between known input data/ECC bits and RS-corrected candidates. Excludes ?, format, version, function, and remainder cells. Locked manual values cannot change at any limit.</string>
